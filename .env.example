# ==============================================================================
# 스마트 통신 쉼터 최적 입지 분석 시스템 환경 설정 템플릿 (.env.example)
# 복사하여 .env 로 이름을 변경한 후 실제 API 키를 입력하세요.
# ==============================================================================

# 1. 공공데이터포털 통합 Open API 키 (국토교통부 버스정류장 및 한국관광공사 TourAPI 공통)
PUBLIC_DATA_PORTAL_API_KEY=YOUR_PUBLIC_DATA_PORTAL_API_KEY_HERE

# 2. 카카오 지도 JavaScript API 키 (카카오 개발자 콘솔 발급 키)
KAKAO_JS_KEY=YOUR_KAKAO_JS_KEY_HERE

# 3. 웹 서버 바인딩 호스트 및 포트
HOST=0.0.0.0
PORT=5000

# 4. 기본 선택 지역 코드
DEFAULT_REGION=busan

# 5. 공공 Wi-Fi 데이터 자동 다운로드 및 갱신 주기 (TTL, 초 단위: 86400 = 24시간)
data_update_ttl=86400

# 6. 한국방송통신전파진흥원(KCA/전파누리) 산악지역 이동통신 기지국 Open API 인증키
MOUNTAIN_API_KEY=YOUR_MOUNTAIN_API_KEY_HERE

