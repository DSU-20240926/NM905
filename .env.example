# ==============================================================================
# 스마트 통신 쉼터 최적 입지 분석 시스템 환경 설정
# ==============================================================================

# 1. 공공데이터포털 통합 Open API 키 (국토교통부 버스정류장 및 한국관광공사 TourAPI 공통)
PUBLIC_DATA_PORTAL_API_KEY=

# 2. 카카오 지도 JavaScript API 키
KAKAO_JS_KEY=

# 3. 웹 서버 바인딩 호스트 및 포트
HOST=0.0.0.0
PORT=5000

# 4. 기본 선택 지역 (seoul, gyeonggi, incheon, daejeon, busan, daegu, gwangju, ulsan, sejong, jeju 등)
DEFAULT_REGION=busan

# 5. 공공 Wi-Fi 데이터 자동 다운로드 및 갱신 주기 (TTL, 초 단위: 86400 = 24시간)
data_update_ttl=86400

# 6. 한국방송통신전파진흥원(KCA/전파누리) 산악지역 이동통신 기지국 Open API 인증키
MOUNTAIN_API_KEY=

# 7. OpenCelliD 전세계 기지국 오픈 API 키 (무료 발급: https://opencellid.org)
# 가입 후 발급받은 Access Token(pk.xxx...)을 아래에 입력하시면 전세계 실시간 기지국 망이 연동됩니다.
OPENCELLID_API_KEY=

# 8. AI 챗봇
# 로컬 LLM 우선 사용 여부 (true: 로컬 LLM 우선 시도 후 실패 시 Gemini 전환 / false: Gemini 즉시 사용)
USE_LOCAL_LLM=false

# 로컬LLM Open-WebUI (1순위 후보)
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=exaone3.5:7.8b

# Google Gemini (2순위 또는 기본 LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite